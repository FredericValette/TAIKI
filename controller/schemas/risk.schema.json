{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiki.dev/schemas/risk.schema.json",
  "title": "TAIKI Risk",
  "type": "object",
  "additionalProperties": false,
  "required": ["riskId", "title", "severity", "likelihood", "status"],
  "properties": {
    "riskId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "likelihood": { "enum": ["unlikely", "possible", "likely", "almost_certain"] },
    "status": { "enum": ["open", "mitigating", "accepted", "closed"] },
    "owner": { "type": "string" },
    "mitigation": { "type": "string" }
  }
}