{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taiki.dev/schemas/controller-run.schema.json",
  "title": "TAIKI Controller Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "skillId", "startedAt", "status", "decision", "evidence"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "failed", "not_assessable"] },
    "decision": { "enum": ["GO", "CONDITIONAL_GO", "NO_GO", "NOT_ASSESSABLE"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "risk.schema.json" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "action.schema.json" }
    }
  }
}